{
  "expo": {
    "name": "Hold",
    "slug": "hold-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hold",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.holdapp.mobile"
    },
    "android": {
      "package": "com.holdapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F4F0E8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
